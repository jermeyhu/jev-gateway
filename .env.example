# Jev Gateway configuration.  Every setting is an environment variable prefixed
# with JEV_; this file is the template, copy it to .env and edit that:
#
#   cp .env.example .env
#
# Docker Compose reads .env automatically.  For a local run, export the values
# into your shell (or use `set -a; . ./.env; set +a`).  A blank value means
# "unset", so it falls back to the built-in default -- which is why every line
# below is safe to leave as-is.
#
# Only the first block is normally needed.  Uncomment what you change; delete
# the rest if you want a minimal file.

# --- Backend -----------------------------------------------------------------
# The OpenAI-compatible server to read next-token logprobs from.  Inside a
# container use a service name or host.docker.internal, never 127.0.0.1.
JEV_BACKEND_BASE_URL=http://127.0.0.1:8080
# Leave blank to let the server pick its own model.
JEV_BACKEND_MODEL=
# Only needed for a hosted provider.
JEV_BACKEND_API_KEY=
# JEV_BACKEND_TIMEOUT_SECONDS=30
# JEV_BACKEND_MAX_CONCURRENCY=32
# How many next-token logprobs to read back.  Raise it if answers come back
# flagged `truncated`, but note the server has its own cap: the OpenAI spec
# allows at most 20, and some servers cap it lower.  Asking for more does not
# error -- the backend just returns `logprobs: null` and every question fails
# with BACKEND_PROTOCOL_ERROR.  Probe a new backend at 20/24/32/64/128 first.
# JEV_BACKEND_TOP_LOGPROBS=128
# true / false / auto.  `auto` assumes images work and falls back on failure.
# JEV_BACKEND_SUPPORTS_IMAGES=auto
# Extra HTTP headers, as a JSON object.
# JEV_BACKEND_EXTRA_HEADERS={"X-Trace": "on"}
# Extra top-level body fields, as a JSON object.  For a reasoning model, this
# is how you stop it thinking so the first token is the candidate letter: a
# leaked `reasoning` field eats the single token `max_tokens: 1` allows and
# `logprobs` comes back null.  llama.cpp / vLLM / SGLang read
# chat_template_kwargs; OpenRouter's openrouter/qwen/* only reads
# reasoning.effort.  Spelling both is safe -- unknown keys are ignored.
# JEV_BACKEND_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}, "reasoning": {"effort": "none"}}

# --- Requests ----------------------------------------------------------------
# JEV_REQUEST_MAX_QUESTIONS=64
# JEV_REQUEST_TOTAL_TIMEOUT_SECONDS=60
# `fused` puts evidence and criterion in one message; `split` gives evidence its
# own message so a long shared prefix can be cached by the backend.
# JEV_REQUEST_PROMPT_LAYOUT=fused

# --- Server ------------------------------------------------------------------
# JEV_SERVER_HOST=0.0.0.0
# JEV_SERVER_PORT=8000

# --- Multimodal --------------------------------------------------------------
# JEV_MULTIMODAL_ENABLED=true
# JEV_MULTIMODAL_MAX_IMAGES=4
# JEV_MULTIMODAL_MAX_IMAGE_BYTES=5242880
# JEV_MULTIMODAL_ALLOW_REMOTE_URLS=false
# Comma-separated MIME prefixes.
# JEV_MULTIMODAL_ALLOWED_MIME_PREFIXES=image/

# --- Logging -----------------------------------------------------------------
# JEV_LOGGING_LEVEL=INFO
